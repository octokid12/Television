[sub_resource type="GDScript" id="GDScript_grmq1"]
script/source = "extends CharacterBody2D

@export var speed = 400
@onready var animation = $Sprite
@onready var Hitbox = $Area2D

var walkturn = 0

var Multtimer: int = 60

var Mode = \"Base\"

signal screen_shake

func get_input():
	var input_direction = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")
	velocity = input_direction * speed
	
	if Input.is_action_just_pressed(\"ui_accept\") and Mode == \"Base\":
		#print(\"jump\")
		Mode = \"Jump\"
		
		
	if input_direction and Mode == \"Base\":
		walkturn += 0.05
		animation.rotation = lerp_angle(rotation, cos(walkturn)/3, 1)
		#print(\"a\")
		$GPUParticles2D.emitting = true
	else:
		$GPUParticles2D.emitting = false
		walkturn = 0
		animation.rotation = lerp_angle(rotation, 0, 0.2)
		
func _physics_process(_delta):
	
	Values.PlayerY = position.y
	
	if Mode == \"Base\":
		Multtimer -= 1
		if Multtimer <= 0:
			Multtimer = 60
			Values.Mult += 1
			
	if Mode == \"Jump\":
		Multtimer -= 1
		if Multtimer <= 0:
			Multtimer = 60
			Values.Mult -= 1
	
	
	get_input()
	move_and_slide()
	animate()
	if len(Hitbox.get_overlapping_areas()) > 0:
		for area in Hitbox.get_overlapping_areas():
			if area.visible: 
				if Mode == \"Base\":
					Mode = \"Hurt\"
					emit_signal(\"HP_Changed\")
					Values.Score = Values.Score/2
					Values.Mult = 0
				if Mode == \"Jump\":
					Values.Score += 1 * Values.Mult

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed == true:
		pass

func animate():
	if Mode == \"Base\":
		animation.play(\"Base\")
		speed = 400
	elif Mode == \"Jump\":
		
		animation.play(\"Jump\")
		speed = 750
		await animation.animation_finished
		Mode = \"Base\"
	if Mode == \"Hurt\":
		animation.play(\"Hurt\")
		speed = 400
		await animation.animation_finished
		Mode = \"Base\"



signal HP_Changed

func _on_area_2d_area_entered(_area: Area2D) -> void:
	print(\"h\")


func _on_firering_area_entered(_area: Area2D) -> void:
	if Mode == \"Jump\":
		$Fire.restart()
		Values.Mult *= 2
"

