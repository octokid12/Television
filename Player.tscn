[sub_resource type="GDScript" id="GDScript_grmq1"]
script/source = "extends CharacterBody2D

@export var speed = 400
@onready var animation = $Sprite

var walkturn = 0

var Mode = \"Base\"

signal screen_shake
signal Firedgun

func get_input():
	var input_direction = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")
	velocity = input_direction * speed
	
	if Input.is_action_just_pressed(\"ui_accept\") and Mode != \"jump\":
		#print(\"jump\")
		Mode = \"Jump\"
		
		
	if input_direction and Mode == \"Base\":
		walkturn += 0.05
		animation.rotation = lerp_angle(rotation, cos(walkturn)/3, 1)
		#print(\"a\")
		$GPUParticles2D.emitting = true
	else:
		$GPUParticles2D.emitting = false
		walkturn = 0
		animation.rotation = 0
		
func _physics_process(_delta):
	get_input()
	move_and_slide()
	animate()

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed == true:
		pass

func animate():
	if Mode == \"Base\":
		$Area2D.monitorable = true
		$Area2D.monitoring = true
		animation.play(\"Base\")
		speed = 400
	elif Mode == \"Jump\":
		$Area2D.monitorable = false
		$Area2D.monitoring = false
		animation.play(\"Jump\")
		speed = 750
		await animation.animation_finished
		Mode = \"Base\"

func _on_animated_sprite_2d_animation_finished() -> void:
	Mode = \"Base\"
	
	print(\"reset\")

signal HP_Changed

func _on_area_2d_area_entered(_area: Area2D) -> void:
	print(\"h\")
	emit_signal(\"HP_Changed\")


func _on_weapon_gun_shot() -> void:
	emit_signal(\"screen_shake\")
	emit_signal(\"Firedgun\")
"

