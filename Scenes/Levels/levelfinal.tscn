[sub_resource type="GDScript" id="GDScript_kfdsr"]
resource_name = "Level1"
script/source = "extends Node2D

@onready var Player = $CharacterBody2D

@onready var Pattern1 = preload(\"res://Scenes/Patterns/shotpattern.tscn\")

@onready var FireTrail = preload(\"res://Scenes/Patterns/firewave_trail.tscn\")
@onready var Car = preload(\"res://Scenes/Patterns/WaterSpout.tscn\")

var FirewaveDelay: int = 100
var Cardelay: int = 300
var Shotdelay: int = 50

func _ready() -> void:
	pass


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(_delta: float) -> void:
	var Shots = Pattern1.instantiate()
	var Wave = FireTrail.instantiate()
	var Vehicle = Car.instantiate()
	
	if FirewaveDelay <= 0:
		FirewaveDelay = 100
		Wave.position = Vector2(-26, randi_range(352, 606))
		add_child(Wave)
	FirewaveDelay -= 1
		
	FirewaveDelay -= 1
	if Cardelay <= 0:
		Cardelay = randi_range(5, 120)
		Vehicle.position = Vector2(randi_range(21, 1104), randi_range(363, 620))
		add_child(Vehicle)
	Cardelay -= 1
	
	Shotdelay -= 1
	if Shotdelay <= 0:
		Shotdelay = randi_range(50, 100)
		Shots.position = Vector2(randi_range(60, 1178), 278)
		add_child(Shots)
"

