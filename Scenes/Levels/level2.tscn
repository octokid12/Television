[sub_resource type="GDScript" id="GDScript_kfdsr"]
resource_name = "Level1"
script/source = "extends Node2D

@onready var Player = $CharacterBody2D

@onready var Pattern1 = preload(\"res://Scenes/Patterns/pattern_1.tscn\")
@onready var Pattern2 = preload(\"res://Scenes/Patterns/pattern_2.tscn\")
@onready var Pattern3 = preload(\"res://Scenes/Patterns/pattern_3hole.tscn\")
@onready var Fring = preload(\"res://fring.tscn\")
var Pattern1Delay: int = 100
var Pattern2Delay: int = 200
var Pattern3Delay:int = 100
var Fringdealy: int = 300

func _ready() -> void:
	pass


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(_delta: float) -> void:
	var SquarePattern = Pattern1.instantiate()
	var unstaggeredSquare = Pattern2.instantiate()
	var Followhole = Pattern3.instantiate()
	var Hoop = Fring.instantiate()
	if Pattern1Delay <= 0:
		Pattern1Delay = 50
		SquarePattern.position = Vector2(randi_range(13, 1148), randi_range(9, 626))
		add_child(SquarePattern)
	Pattern1Delay -= 1
	
	
	if Pattern2Delay <= 0:
		Pattern2Delay = 50
		unstaggeredSquare.position = Vector2(randi_range(13, 1148), randi_range(9, 626))
		add_child(unstaggeredSquare)
	Pattern2Delay -= 1
	
	if Pattern3Delay <= 0:
		Pattern3Delay = 75
		Followhole.position = Vector2(Player.position.x + randi_range(20, -20), Player.position.y + 193)
		add_child(Followhole)
	Pattern3Delay -= 1
	
	if Fringdealy <= 0:
		Fringdealy = 200
		Hoop.position = Vector2(randi_range(43, 1079), randi_range(100, 356))
		add_child(Hoop)
	Fringdealy -= 1
"

