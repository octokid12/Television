[sub_resource type="GDScript" id="GDScript_grmq1"]
script/source = "extends VBoxContainer

@onready var Lawn = $Lawn
@onready var Road = $Road
@onready var Bus = $Bus
@onready var Endless = $Endless

func _process(_delta: float) -> void:
	Endless.text = \"Endless: \" + str(Values.EndlesHi)
	Lawn.text = \"Lawn: \" + str(Values.Highscores[0])
	Road.text = \"Road: \" + str(Values.Highscores[1])
	Bus.text = \"Bus: \" + str(Values.Highscores[2])
"

