[sub_resource type="GDScript" id="GDScript_kfdsr"]
resource_name = "Level1"
script/source = "extends Node2D

@onready var Player = $CharacterBody2D

@onready var Pattern1 = preload(\"res://Scenes/Patterns/pattern_1.tscn\")
@onready var Pattern2 = preload(\"res://Scenes/Patterns/pattern_2.tscn\")
@onready var Pattern3 = preload(\"res://Scenes/Patterns/pattern_3hole.tscn\")
@onready var Fring = preload(\"res://fring.tscn\")
@onready var Car = preload(\"res://Scenes/Patterns/car.tscn\")
@onready var Fire = preload(\"res://Scenes/Patterns/firewave_trail.tscn\")
@onready var Spout = preload(\"res://Scenes/Patterns/WaterSpout.tscn\")

var Pattern1Delay: int = 250
var Pattern2Delay: int = 500
var Pattern3Delay:int = 200
var Fringdealy: int = 300
var Cardelay: int = 200
var FirewaveDelay: int = 150
var SpoutDelay: int = 2000


var MaxPattern1Delay: int = 500
var MaxPattern2Delay: int = 500
var MaxPattern3Delay:int = 500
var MaxFringdealy: int = 500
var MaxCardelay: int = 500
var MaxFirewaveDelay: int = 350



func _ready() -> void:
	pass


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(_delta: float) -> void:
	var SquarePattern = Pattern1.instantiate()
	var unstaggeredSquare = Pattern2.instantiate()
	var Followhole = Pattern3.instantiate()
	var Hoop = Fring.instantiate()
	var Vehicle = Car.instantiate()
	var Wave = Fire.instantiate()
	var Water = Spout.instantiate()
	if Fringdealy <= 0:
		Fringdealy = MaxFringdealy
		MaxFringdealy -= 5
		Hoop.position = Vector2(randi_range(47, 1104), randi_range(100, 343))
		add_child(Hoop)
	Fringdealy -= 1
	
	
	if Pattern1Delay <= 0:
		Pattern1Delay = MaxPattern1Delay
		MaxPattern1Delay -= 5
		SquarePattern.position = Vector2(randi_range(13, 1104), randi_range(9, 626))
		add_child(SquarePattern)
	Pattern1Delay -= 1
	
	
	if Pattern2Delay <= 0:
		Pattern2Delay = MaxPattern2Delay
		MaxPattern2Delay -= 5
		unstaggeredSquare.position = Vector2(randi_range(13, 1104), randi_range(9, 626))
		add_child(unstaggeredSquare)
	Pattern2Delay -= 1
	
	if Pattern3Delay <= 0:
		Pattern3Delay = MaxPattern3Delay
		MaxPattern3Delay -= 5
		Followhole.position = Vector2(Player.position.x + randi_range(20, -20), Player.position.y + 193)
		add_child(Followhole)
	Pattern3Delay -= 1
	

	if Cardelay <= 0:
		Cardelay = MaxCardelay
		MaxCardelay -= 5
		Vehicle.position = Vector2(randi_range(43, 1082), 127)
		add_child(Vehicle)
	Cardelay -= 1
	
	if FirewaveDelay <= 0:
		FirewaveDelay = MaxFirewaveDelay
		MaxFirewaveDelay -= 10
		Wave.position = Vector2(-26, randi_range(37, 606))
		add_child(Wave)
		
	FirewaveDelay -= 1



	if SpoutDelay <= 0:
		SpoutDelay = randi_range(5, 60)
		Water.position = Vector2(randi_range(21, 1104), randi_range(25, 620))
		add_child(Water)
	SpoutDelay -= 1
"

